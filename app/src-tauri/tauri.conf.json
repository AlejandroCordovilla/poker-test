{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Poker Trainer",
  "version": "0.1.0",
  "identifier": "dev.local.pokertrainer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "title": "Poker Trainer", "width": 1180, "height": 820, "minWidth": 900, "minHeight": 640 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"]
  }
}
